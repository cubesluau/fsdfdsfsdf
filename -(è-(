			return self._size
		end, function(delta, startSize)
			local maxW = math.max(self._minSize.X, self._vp.X - self._pos.X - 8)
			local maxH = math.max(self._minSize.Y, self._vp.Y - self._pos.Y - 8)
			local w = math.clamp(startSize.X + delta.X, self._minSize.X, maxW)
			local h = math.clamp(startSize.Y + delta.Y, self._minSize.Y, maxH)
			self._size = Vector2.new(w, h)
			self.Holder.Size = UDim2.fromOffset(w, h)
		end)
	end

