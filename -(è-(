-- Maid: collects connections / instances / functions and cleans them together.
local Maid = {}
Maid.__index = Maid

function Maid.new()
	return setmetatable({ _tasks = {} }, Maid)
end

function Maid:Give(item)
	table.insert(self._tasks, item)
	return item
end

function Maid:Clean()
	local tasks = self._tasks
	self._tasks = {}
	for _, item in ipairs(tasks) do
		local kind = typeof(item)
		if kind == "RBXScriptConnection" then
			item:Disconnect()
		elseif kind == "Instance" then
			item:Destroy()
		elseif kind == "function" then
			pcall(item)
		elseif kind == "table" and item.Destroy then
			pcall(item.Destroy, item)
		end
	end
end

-- Instance factory with sane GUI defaults.
local function New(class, props)
	local inst = Instance.new(class)
	if inst:IsA("GuiObject") then
		inst.BorderSizePixel = 0
		if class ~= "Frame" and class ~= "TextBox" then
			inst.BackgroundTransparency = 1
		end
		if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
			inst.Font = Enum.Font.GothamMedium
			inst.TextSize = 13
		end
		if inst:IsA("TextLabel") or inst:IsA("TextButton") then
			inst.Text = ""
		end
		if inst:IsA("TextButton") then
			inst.AutoButtonColor = false
		end
	end
	local parent
	for key, value in pairs(props or {}) do
		if key == "Parent" then
			parent = value
		else
			inst[key] = value
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function Corner(radius, parent)
	return New("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end

local function Pad(top, right, bottom, left, parent)
	return New("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right),
		PaddingBottom = UDim.new(0, bottom),
		PaddingLeft = UDim.new(0, left),
		Parent = parent,
	})
end

local function List(padding, parent, direction, extra)
	local props = {
		Padding = UDim.new(0, padding or 0),
		SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = direction or Enum.FillDirection.Vertical,
		Parent = parent,
	}
	if extra then
		for key, value in pairs(extra) do
			props[key] = value
		end
	end
	return New("UIListLayout", props)
end

local function safeCall(fn, ...)
	if type(fn) ~= "function" then
		return
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[NebulaUI] Callback error: " .. tostring(err))
	end
end

local function textHeight(text, size, font, width)
	return TextService:GetTextSize(text, size, font, Vector2.new(width, 10000)).Y
end

local function decimalsOf(n)
	local s = string.format("%.6f", n)
	s = string.gsub(s, "0+$", "")
	local dot = string.find(s, ".", 1, true)
	if not dot then
		return 0
	end
	return math.max(#s - dot, 0)
end

local function snap(value, min, max, increment)
	value = math.clamp(value, min, max)
	if increment and increment > 0 then
		value = min + math.floor((value - min) / increment + 0.5) * increment
	end
	value = math.clamp(value, min, max)
	local m = 10 ^ decimalsOf(increment or 1)
	return math.floor(value * m + 0.5) / m
end

local function toKeyCode(value)
	if typeof(value) == "EnumItem" then
		return value
	end
	if type(value) == "string" then
		local ok, result = pcall(function()
			return Enum.KeyCode[value]
		end)
		if ok then
			return result
		end
	end
	return nil
end

-- Built-in glyph icons. Any short string/emoji or an rbxassetid:// image also works.
local ICONS = {
	home = "⌂", settings = "⚙", info = "ℹ", star = "★", user = "☻", bolt = "⚡",
	eye = "◉", target = "◎", list = "☰", play = "▶", shield = "◈", tools = "✦",
	code = "{}", palette = "◐", sword = "⚔", heart = "♥", globe = "◍", flag = "⚑",
}

local function resolveIcon(icon, name)
	if type(icon) == "number" then
		return "image", "rbxassetid://" .. tostring(icon)
	end
	if type(icon) == "string" and icon ~= "" then
		local lower = string.lower(icon)
		if string.find(lower, "^rbxassetid://") or string.find(lower, "^rbxasset://") or string.find(lower, "^http") then
			return "image", icon
		end
		if ICONS[lower] then
			return "text", ICONS[lower]
		end
		local len = utf8.len(icon)
		if len and len <= 3 then
			return "text", icon
		end
	end
	return "text", string.upper(string.sub(name or "?", 1, 1))
end

