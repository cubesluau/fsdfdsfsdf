local function memoryProvider()
	local store = {}
	return {
		Save = function(name, json)
			store[name] = json
		end,
		Load = function(name)
			return store[name]
		end,
		Delete = function(name)
			store[name] = nil
		end,
		List = function()
			local names = {}
			for name in pairs(store) do
				table.insert(names, name)
			end
			table.sort(names)
			return names
		end,
	}
end

