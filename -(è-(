		LayoutOrder = 2,
		Parent = card,
	})
	List(6, body)
	return card, body
end

Section.__index = function(self, key)
	local method = rawget(Section, key)
	if method ~= nil then
		return method
	end
	if type(key) == "string" then
		local name = string.match(key, "^Create(%w+)$")
		if name and Components[name] then
			return function(section, opts)
				return section:_create(name, opts)
			end
		end
	end
	return nil
end

function Section.new(tab, opts)
	if type(opts) == "string" then
		opts = { Name = opts }
	end
	opts = opts or {}
	local self = setmetatable({}, Section)
	self.Library = tab.Library
	self.Tab = tab
	self.Name = opts.Name
	self.Scroll = tab.Scroll
	self._order = 0
	self._components = {}
	self.Card, self.Body = self.Library:_card(tab.Scroll, opts.Name, tab:_nextOrder())
	return self
end

function Section:_nextOrder()
	self._order = self._order + 1
	return self._order
end

function Section:_create(name, opts)
	local builder = Components[name]
	if type(opts) == "string" then
		opts = { Name = opts }
	end
	local obj = builder(self, opts or {})
	table.insert(self._components, obj)
	self.Library._componentCount = self.Library._componentCount + 1
	self.Library:_queueHome()
	return obj
end

function Section:Destroy()
	for index = #self._components, 1, -1 do
		local component = self._components[index]
		if component and component.Destroy then
			component:Destroy()
		end
	end
	self.Card:Destroy()
	local list = self.Tab.Sections
	local position = table.find(list, self)
	if position then
		table.remove(list, position)
	end
end

Tab.__index = function(self, key)
	local method = rawget(Tab, key)
	if method ~= nil then
		return method
	end
	if type(key) == "string" then
		local name = string.match(key, "^Create(%w+)$")
		if name and Components[name] then
			return function(tab, opts)
				return tab:_defaultSection():_create(name, opts)
			end
		end
	end
	return nil
end

function Tab.new(lib, opts)
	local self = setmetatable({}, Tab)
	self.Library = lib
	self.Name = tostring(opts.Name or "Tab")
	self.Icon = opts.Icon
	self.Kind = opts.Kind or "User"
	self.Description = opts.Description
	self.Sections = {}
	self._order = 0

	local parentList = opts.Bottom and lib.BottomTabs or lib.TabList
	local active, hover = false, false

	local button = New("Frame", {
		Name = "Tab_" .. self.Name,
		Size = UDim2.new(1, 0, 0, 36),
		LayoutOrder = opts.Order or lib:_nextTabOrder(),
		Parent = parentList,
	})
	Corner(8, button)
	lib:_bind(button, function(theme)
		if active then
			return { BackgroundColor3 = theme.Accent, BackgroundTransparency = 0.84 }
		elseif hover then
			return { BackgroundColor3 = theme.SurfaceHover, BackgroundTransparency = 0.35 }
		end
		return { BackgroundColor3 = theme.SurfaceHover, BackgroundTransparency = 1 }
	end)

	local indicator = New("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(3, 0),
		Parent = button,
	})
	Corner(2, indicator)
	lib:_bind(indicator, function(theme)
		return { Size = UDim2.fromOffset(3, active and 18 or 0), BackgroundColor3 = theme.Accent }
	end)

	local icon = New("Frame", {
		Position = UDim2.fromOffset(13, 8),
		Size = UDim2.fromOffset(20, 20),
		BackgroundTransparency = 1,
		Parent = button,
	})
	local iconInstance
	do
		local kind, value = resolveIcon(self.Icon, self.Name)
		local property
		if kind == "image" then
			iconInstance = New("ImageLabel", { Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(1, 1), Image = value, ScaleType = Enum.ScaleType.Fit, Parent = icon })
			property = "ImageColor3"
		else
			iconInstance = New("TextLabel", { Size = UDim2.fromScale(1, 1), Text = value, TextSize = 16, Font = Enum.Font.GothamBold, Parent = icon })
			property = "TextColor3"
		end
		lib:_bind(iconInstance, function(theme)
			return { [property] = active and theme.Accent or theme.SubText }
		end)
	end

	local title = New("TextLabel", {
		Position = UDim2.fromOffset(42, 0),
		Size = UDim2.new(1, -50, 1, 0),
		Text = self.Name,
		TextXAlignment = LEFT,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = button,
	})
	lib:_bind(title, function(theme)
		return { TextColor3 = active and theme.Text or theme.SubText }
	end)

	local hit = New("TextButton", { Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = button })
	hit.MouseEnter:Connect(function()
		hover = true
		lib:Refresh(button, 0.12)
	end)
	hit.MouseLeave:Connect(function()
		hover = false
		lib:Refresh(button, 0.12)
	end)
	hit.Activated:Connect(function()
		lib:SelectTab(self)
	end)

	function self:_setActive(value)
		active = value
		lib:Refresh(button, 0.2)
		lib:Refresh(indicator, 0.25)
		lib:Refresh(iconInstance, 0.2)
		lib:Refresh(title, 0.2)
	end
	self.Button = button

	-- Page
	self.Page = New("CanvasGroup", {
		Name = "Page_" .. self.Name,
		Size = UDim2.fromScale(1, 1),
		GroupTransparency = 1,
		Visible = false,
		Parent = lib.Pages,
	})
	self.Scroll = New("ScrollingFrame", {
		Name = "Scroll",
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = AUTO_Y,
		ScrollBarThickness = 3,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ElasticBehavior = Enum.ElasticBehavior.Never,
		Parent = self.Page,
	})
	lib:Style(self.Scroll, { ScrollBarImageColor3 = "Muted" })
	List(12, self.Scroll)
	Pad(2, 8, 16, 0, self.Scroll)

	if not opts.NoHeader then
		local header = New("Frame", {
			Name = "Header",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = AUTO_Y,
			BackgroundTransparency = 1,
			LayoutOrder = 0,
			Parent = self.Scroll,
		})
		List(2, header)
		local titleLabel = New("TextLabel", {
			Size = UDim2.new(1, 0, 0, 26),
			Text = self.Name,
			TextXAlignment = LEFT,
			Font = Enum.Font.GothamBold,
			TextSize = 20,
			LayoutOrder = 1,
			Parent = header,
		})
		lib:Style(titleLabel, { TextColor3 = "Text" })
		if self.Description and self.Description ~= "" then
			local descLabel = New("TextLabel", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = AUTO_Y,
				Text = tostring(self.Description),
				TextWrapped = true,
				TextXAlignment = LEFT,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextSize = 12,
				Font = Enum.Font.Gotham,
				LayoutOrder = 2,
				Parent = header,
			})
			lib:Style(descLabel, { TextColor3 = "SubText" })
		end
	end

	table.insert(lib._allTabs, self)
	return self
end

function Tab:_nextOrder()
	self._order = self._order + 1
	return self._order
end

function Tab:_defaultSection()
	if not self._default then
		self._default = Section.new(self, {})
	end
	return self._default
end

function Tab:CreateSection(opts)
	local section = Section.new(self, opts)
	table.insert(self.Sections, section)
	return section
end

function Tab:Select()
	self.Library:SelectTab(self)
end

function Tab:Destroy()
	local lib = self.Library
	for index = #self.Sections, 1, -1 do
		self.Sections[index]:Destroy()
	end
	if self._default then
		self._default:Destroy()
	end
	for _, list in ipairs({ lib._tabs, lib._allTabs }) do
		local position = table.find(list, self)
		if position then
			table.remove(list, position)
		end
	end
	local wasCurrent = lib.CurrentTab == self
	self.Button:Destroy()
	self.Page:Destroy()
	if wasCurrent then
		lib.CurrentTab = nil
		local fallback = lib.HomeTab or lib._tabs[1] or lib._allTabs[1]
		if fallback then
			lib:SelectTab(fallback, true)
		end
	end
	lib:_queueHome()
end

function Library:_nextTabOrder()
	self._tabOrder = self._tabOrder + 1
	return self._tabOrder
end

function Library:CreateTab(opts)
	if type(opts) == "string" then
		opts = { Name = opts }
	end
	opts = opts or {}
	opts.Kind = "User"
	local tab = Tab.new(self, opts)
	table.insert(self._tabs, tab)
	if not self.CurrentTab then
		self:SelectTab(tab, true)
	end
	self:LogActivity("Registered tab '" .. tab.Name .. "'", "info")
	return tab
end

function Library:GetTab(name)
	for _, tab in ipairs(self._allTabs) do
		if tab.Name == name then
			return tab
		end
	end
	return nil
end

function Library:SelectTab(tab, instant)
	if type(tab) == "string" then
		tab = self:GetTab(tab)
	end
	if not tab or self.CurrentTab == tab then
		return
	end
	local old = self.CurrentTab
	self.CurrentTab = tab
	if old then
		old:_setActive(false)
		local oldPage = old.Page
		self:Tween(oldPage, 0.12, { GroupTransparency = 1 }, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, function()
			if self.CurrentTab ~= old then
				oldPage.Visible = false
			end
		end)
	end
	tab:_setActive(true)
	tab.Page.Visible = true
	if instant or not old then
		tab.Page.GroupTransparency = 0
		tab.Page.Position = UDim2.new()
	else
		tab.Page.GroupTransparency = 1
		tab.Page.Position = UDim2.fromOffset(0, 14)
		self:Tween(tab.Page, 0.32, { GroupTransparency = 0, Position = UDim2.new() }, Enum.EasingStyle.Quint)
		self:LogActivity("Opened " .. tab.Name, "nav")
	end
end

