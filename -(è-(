		lib:_setFlag(opts.Flag, key)
		if not silent then
			safeCall(opts.OnChanged, key)
		end
	end
	function obj:SetMode(newMode)
		mode = newMode == "Hold" and "Hold" or "Toggle"
		active = false
		updateText()
	end
	function obj:_serialize()
		return { Key = key and key.Name or "None", Mode = mode }
	end
	function obj:_deserialize(data)
		if type(data) == "table" then
			obj:SetValue(data.Key ~= "None" and data.Key or nil, true)
			obj:SetMode(data.Mode)
		end
	end

	function obj:_press(code)
		if not key or code ~= key then
			return
		end
		if mode == "Hold" then
			active = true
		else
			active = not active
		end
		safeCall(opts.Callback, active)
	end
	function obj:_release(code)
		if key and code == key and mode == "Hold" and active then
			active = false
			safeCall(opts.Callback, false)
		end
	end

	keyButton.Activated:Connect(function()
		if listening then
			return
		end
		listening = true
		lib._listening = obj
		keyButton.Text = "..."
		local connection
		connection = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.Keyboard then
				return
			end
			connection:Disconnect()
			if input.KeyCode == Enum.KeyCode.Escape then
				updateText()
			elseif input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
				obj:SetValue(nil)
			else
				obj:SetValue(input.KeyCode)
				lib:LogActivity(tostring(opts.Name) .. " bound to " .. input.KeyCode.Name, "info")
			end
			listening = false
			task.defer(function()
				lib._listening = nil
			end)
		end)
		maid:Give(connection)
	end)
	modeButton.Activated:Connect(function()
		obj:SetMode(mode == "Toggle" and "Hold" or "Toggle")
		lib:_setFlag(opts.Flag, key)
	end)

	updateText()
	lib._keybinds[obj] = true
	lib:_registerFlag(opts.Flag, obj)
	return Finish(section, obj, r.Row, maid, function()
		lib._keybinds[obj] = nil
		if lib._listening == obj then
			lib._listening = nil
		end
		if opts.Flag then
			lib._flagObjects[opts.Flag] = nil
		end
	end)
end

