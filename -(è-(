local KIND_COLOR = {
	success = "Success", warning = "Warning", error = "Error", info = "Info", nav = "Accent",
}

local function formatDuration(seconds)
	seconds = math.floor(seconds)
	return string.format("%02d:%02d:%02d", math.floor(seconds / 3600), math.floor(seconds / 60) % 60, seconds % 60)
end

function Library:CreateHome(opts)
	if self.Home then
		return self.Home
	end
	opts = opts or {}
	local lib = self
	if opts.Username then
		self.Username = tostring(opts.Username)
		self.UserLabel.Text = self.Username
		self.AvatarLabel.Text = string.upper(string.sub(self.Username, 1, 1))
	end
	if opts.Description then
		self.Description = tostring(opts.Description)
	end

	local tab = Tab.new(self, { Name = "Home", Icon = "home", Kind = "Home", NoHeader = true, Order = 0 })
	local scroll = tab.Scroll
	local home = { Tab = tab }
	self.Home = home
	self.HomeTab = tab

	-- Hero banner ---------------------------------------------------------------------------
	local hero = New("Frame", {
		Name = "Hero",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = AUTO_Y,
		BackgroundColor3 = Color3.new(1, 1, 1),
		ClipsDescendants = true,
		LayoutOrder = 1,
		Parent = scroll,
	})
	Corner(12, hero)
	local heroGradient = New("UIGradient", { Rotation = 20, Parent = hero })
	self:_bind(heroGradient, function(theme)
		return { Color = ColorSequence.new(theme.Accent, theme.AccentDark) }
	end)
	local decor = New("Frame", { Name = "Decor", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = hero })
	for _, spec in ipairs({ { 1, -10, 0, 190, 0.9 }, { 1, -120, 1, 130, 0.92 }, { 0.62, 0, 1, 90, 0.94 } }) do
		local circle = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(spec[1], spec[2], spec[3], 0),
			Size = UDim2.fromOffset(spec[4], spec[4]),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = spec[5],
			Parent = decor,
		})
		Corner(math.floor(spec[4] / 2), circle)
	end
	local heroContent = New("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = AUTO_Y,
		BackgroundTransparency = 1,
		Parent = hero,
	})
	Pad(18, 18, 18, 20, heroContent)
	List(4, heroContent)
	local function heroLabel(text, size, font, transparency, order)
		return New("TextLabel", {
			Size = UDim2.new(0.72, 0, 0, 0),
			AutomaticSize = AUTO_Y,
			Text = text,
			TextWrapped = true,
			TextXAlignment = LEFT,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextSize = size,
			Font = font,
			TextColor3 = Color3.new(1, 1, 1),
			TextTransparency = transparency,
			LayoutOrder = order,
			Parent = heroContent,
		})
	end
	heroLabel("WELCOME BACK", 11, Enum.Font.GothamBold, 0.25, 1)
	local greeting = heroLabel("", 26, Enum.Font.GothamBold, 0, 2)
	local appLine = heroLabel("", 13, Enum.Font.GothamMedium, 0.1, 3)
	local descLine = heroLabel("", 12, Enum.Font.Gotham, 0.2, 4)

	-- Status cards ---------------------------------------------------------------------------
	local stats = New("Frame", {
		Name = "Stats",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = AUTO_Y,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = scroll,
	})
	local grid = New("UIGridLayout", {
		CellSize = UDim2.new(0.25, -9, 0, 78),
		CellPadding = UDim2.fromOffset(12, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = stats,
	})
	stats:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		local narrow = stats.AbsoluteSize.X < 440 * self._scale
		grid.CellSize = narrow and UDim2.new(0.5, -6, 0, 78) or UDim2.new(0.25, -9, 0, 78)
	end)

	local function statCard(order, glyph, title)
		local card = New("Frame", { LayoutOrder = order, BackgroundTransparency = 0.2, Parent = stats })
		Corner(10, card)
		lib:Style(card, { BackgroundColor3 = "Surface" })
		lib:Stroke(card, 0.35)
		Pad(12, 12, 10, 12, card)
		local iconBg = New("Frame", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 0),
			Size = UDim2.fromOffset(26, 26),
			Parent = card,
		})
		Corner(8, iconBg)
		lib:_bind(iconBg, function(theme)
			return { BackgroundColor3 = theme.Accent, BackgroundTransparency = 0.82 }
		end)
		local iconText = New("TextLabel", { Size = UDim2.fromScale(1, 1), Text = glyph, TextSize = 14, Font = Enum.Font.GothamBold, Parent = iconBg })
		lib:Style(iconText, { TextColor3 = "Accent" })
		local titleLabel = New("TextLabel", {
			Size = UDim2.new(1, -32, 0, 14),
			Text = string.upper(title),
			TextXAlignment = LEFT,
			TextSize = 10,
			Font = Enum.Font.GothamBold,
			Parent = card,
		})
		lib:Style(titleLabel, { TextColor3 = "SubText" })
		local valueLabel = New("TextLabel", {
			Position = UDim2.fromOffset(0, 20),
			Size = UDim2.new(1, 0, 0, 24),
			TextXAlignment = LEFT,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextSize = 19,
			Font = Enum.Font.GothamBold,
			Parent = card,
		})
		lib:Style(valueLabel, { TextColor3 = "Text" })
		local subLabel = New("TextLabel", {
			Position = UDim2.fromOffset(0, 46),
			Size = UDim2.new(1, 0, 0, 14),
			TextXAlignment = LEFT,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextSize = 11,
			Font = Enum.Font.Gotham,
			Parent = card,
		})
		lib:Style(subLabel, { TextColor3 = "SubText" })
		return valueLabel, subLabel
	end
	local themeValue, themeSub = statCard(1, "◐", "Theme")
	local tabsValue, tabsSub = statCard(2, "☰", "Tabs")
	local togglesValue, togglesSub = statCard(3, "⚡", "Active toggles")
	local sessionValue, sessionSub = statCard(4, "◷", "Session")

	-- Quick navigation -----------------------------------------------------------------------
	local _, navBody = self:_card(scroll, "Quick Navigation", 3)
	local chips = New("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = AUTO_Y,
		BackgroundTransparency = 1,
		Parent = navBody,
	})
	List(8, chips, Enum.FillDirection.Horizontal, { Wraps = true })
	local navKey = nil
	local function rebuildNav()
		local targets = {}
		for _, item in ipairs(lib._tabs) do
			table.insert(targets, item)
		end
		for _, item in ipairs(lib._allTabs) do
			if item.Kind == "Settings" or item.Kind == "About" then
				table.insert(targets, item)
			end
		end
		local names = {}
		for _, item in ipairs(targets) do
			table.insert(names, item.Name)
		end
		local key = table.concat(names, "|")
		if key == navKey then
			return
		end
		navKey = key
		for _, child in ipairs(chips:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		for index, item in ipairs(targets) do
			local hover = false
			local _, glyph = resolveIcon(item.Icon, item.Name)
			if type(item.Icon) == "string" and string.find(item.Icon, "^rbxasset") then
				glyph = string.upper(string.sub(item.Name, 1, 1))
			end
			local chip = New("TextButton", {
				Size = UDim2.new(0, 0, 0, 30),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundTransparency = 0,
				Text = glyph .. "  " .. item.Name,
				TextSize = 12,
				LayoutOrder = index,
				Parent = chips,
			})
			Corner(8, chip)
			Pad(0, 12, 0, 12, chip)
			lib:_bind(chip, function(theme)
				return {
					BackgroundColor3 = hover and theme.SurfaceHover or theme.SurfaceAlt,
					TextColor3 = hover and theme.Text or theme.SubText,
				}
			end)
			lib:Stroke(chip, 0.4)
			chip.MouseEnter:Connect(function()
				hover = true
				lib:Refresh(chip, 0.12)
			end)
			chip.MouseLeave:Connect(function()
				hover = false
				lib:Refresh(chip, 0.12)
			end)
			chip.Activated:Connect(function()
				lib:SelectTab(item)
			end)
		end
	end

	-- Recent activity ------------------------------------------------------------------------
	local _, activityBody = self:_card(scroll, "Recent Activity", 4)
	local function rebuildActivity()
		for _, child in ipairs(activityBody:GetChildren()) do
			if child:IsA("Frame") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		if #lib._activity == 0 then
			local empty = New("TextLabel", {
				Size = UDim2.new(1, 0, 0, 24),
				Text = "Nothing yet - interact with the interface and activity shows up here.",
				TextXAlignment = LEFT,
				TextSize = 12,
				Font = Enum.Font.Gotham,
				Parent = activityBody,
			})
			lib:Style(empty, { TextColor3 = "Muted" })
			return
		end
		for index = 1, math.min(#lib._activity, 6) do
			local entry = lib._activity[index]
			local row = New("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, LayoutOrder = index, Parent = activityBody })
			local dot = New("Frame", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 2, 0.5, 0),
				Size = UDim2.fromOffset(8, 8),
				Parent = row,
			})
			Corner(4, dot)
			lib:Style(dot, { BackgroundColor3 = KIND_COLOR[entry.Kind] or "Accent" })
			local text = New("TextLabel", {
				Position = UDim2.fromOffset(20, 0),
				Size = UDim2.new(1, -88, 1, 0),
				Text = entry.Text,
				TextXAlignment = LEFT,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextSize = 12,
				Parent = row,
			})
			lib:Style(text, { TextColor3 = "Text" })
			local time = New("TextLabel", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 0),
				Size = UDim2.fromOffset(64, 26),
				Text = entry.Time,
				TextXAlignment = RIGHT,
				TextSize = 11,
				Font = Enum.Font.Gotham,
				Parent = row,
			})
			lib:Style(time, { TextColor3 = "Muted" })
		end
	end

	-- Library info + developer ---------------------------------------------------------------
	local infoRow = New("Frame", {
		Name = "Info",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = AUTO_Y,
		BackgroundTransparency = 1,
		LayoutOrder = 5,
		Parent = scroll,
	})
	List(12, infoRow, Enum.FillDirection.Horizontal)
	local function kvRow(body, key, order)
		local row = New("Frame", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, LayoutOrder = order, Parent = body })
		local keyLabel = New("TextLabel", {
			Size = UDim2.new(0.45, 0, 1, 0),
			Text = key,
			TextXAlignment = LEFT,
			TextSize = 12,
			Font = Enum.Font.Gotham,
			Parent = row,
		})
		lib:Style(keyLabel, { TextColor3 = "SubText" })
		local valueLabel = New("TextLabel", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 0),
			Size = UDim2.new(0.55, 0, 1, 0),
			TextXAlignment = RIGHT,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextSize = 12,
			Parent = row,
		})
		lib:Style(valueLabel, { TextColor3 = "Text" })
		return valueLabel
	end
	local libCard, libBody = self:_card(infoRow, "Library", 1)
	libCard.Size = UDim2.new(0.5, -6, 0, 0)
	local libName = kvRow(libBody, "Library", 1)
	local libVersion = kvRow(libBody, "Version", 2)
	local libComponents = kvRow(libBody, "Components", 3)
	local libScale = kvRow(libBody, "UI scale", 4)
	local devCard, devBody = self:_card(infoRow, "Developer", 2)
	devCard.Size = UDim2.new(0.5, -6, 0, 0)
	local devName = kvRow(devBody, "Developer", 1)
	local creditsText = New("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = AUTO_Y,
		TextWrapped = true,
		TextXAlignment = LEFT,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextSize = 12,
		Font = Enum.Font.Gotham,
		LayoutOrder = 2,
		Parent = devBody,
	})
	lib:Style(creditsText, { TextColor3 = "SubText" })

	function home.Refresh()
		greeting.Text = "Hello, " .. lib.Username
		appLine.Text = lib.Name .. "  ·  v" .. lib.AppVersion
		descLine.Text = lib.Description
		themeValue.Text = lib.Settings.Theme
		themeSub.Text = "Accent #" .. lib.Settings.Accent:ToHex()
		tabsValue.Text = tostring(#lib._tabs)
		tabsSub.Text = "registered"
		local total, activeCount = 0, 0
		for toggle in pairs(lib._toggles) do
			total = total + 1
			if toggle:GetValue() then
				activeCount = activeCount + 1
			end
		end
		togglesValue.Text = tostring(activeCount)
		togglesSub.Text = "of " .. total .. " toggles"
		sessionValue.Text = formatDuration(os.clock() - lib._startTime)
		sessionSub.Text = "since load"
		libName.Text = "Nebula UI"
		libVersion.Text = Library.Version
		libComponents.Text = tostring(lib._componentCount)
		libScale.Text = string.format("%d%%", math.floor(lib._scale * 100 + 0.5))
		devName.Text = lib.Developer
		if #lib.Credits > 0 then
			creditsText.Text = table.concat(lib.Credits, "\n")
		else
			creditsText.Text = "Built with Nebula UI."
		end
		rebuildNav()
		rebuildActivity()
	end
	home.Refresh()

	task.spawn(function()
		while not lib.Destroyed and lib.Home == home do
			task.wait(1)
			if lib.Visible and lib.CurrentTab == tab then
				sessionValue.Text = formatDuration(os.clock() - lib._startTime)
			end
		end
	end)

	self:SelectTab(tab, true)
	return home
end

function Library:_buildSettings()
	local tab = Tab.new(self, {
		Name = "Settings",
		Icon = "settings",
		Kind = "Settings",
		Bottom = true,
		Order = 1,
		Description = "Customize the interface, keybinds and saved configurations.",
	})
	self.SettingsTab = tab
	self._ui = {}

	local appearance = tab:CreateSection("Appearance")
	self._ui.Theme = appearance:CreateDropdown({
		Name = "Theme",
		Description = "Switch the colour palette of the whole interface.",
		Options = ThemeOrder,
		Default = self.Settings.Theme,
		Flag = "NebulaTheme",
		FireOnInit = false,
		Callback = function(value)
			self:SetTheme(value)
		end,
	})
	self._ui.Accent = appearance:CreateColorPicker({
		Name = "Accent colour",
		Description = "Used for highlights, toggles and sliders.",
		Default = self.Settings.Accent,
		Flag = "NebulaAccent",
		FireOnInit = false,
		Callback = function(color)
			self:SetAccent(color)
		end,
	})
	self._ui.Scale = appearance:CreateDropdown({
		Name = "UI scale",
		Description = "Resize the whole interface.",
		Options = { "75%", "90%", "100%", "110%", "125%", "150%" },
		Default = "100%",
		Search = false,
		Flag = "NebulaScale",
		FireOnInit = false,
		Callback = function(value)
			local percent = tonumber((string.gsub(tostring(value), "%%", "")))
			if percent then
				self.Settings.Scale = percent / 100
				self:_updateScale()
				self:_queueHome()
			end
		end,
	})

	local animation = tab:CreateSection("Animations")
	self._ui.Animations = animation:CreateToggle({
		Name = "Enable animations",
		Description = "Turn off to make every transition instant.",
		Default = true,
		Flag = "NebulaAnimations",
		FireOnInit = false,
		Callback = function(value)
			self.Settings.Animations = value
		end,
	})
	animation:CreateSlider({
		Name = "Animation speed",
		Min = 0.5,
		Max = 2,
		Increment = 0.1,
		Default = 1,
		Suffix = "x",
		Flag = "NebulaAnimSpeed",
		FireOnInit = false,
		Callback = function(value)
			self.Settings.AnimSpeed = value
		end,
	})
	animation:CreateToggle({
		Name = "Notifications",
		Description = "Show toast notifications in the corner of the screen.",
		Default = true,
		Flag = "NebulaNotifications",
		FireOnInit = false,
		Callback = function(value)
			self.Settings.Notifications = value
		end,
	})

	local keys = tab:CreateSection("Keybinds")
	keys:CreateKeybind({
		Name = "Toggle interface",
		Description = "Click the key to rebind it. Mode switches between Toggle and Hold.",
		Default = self.Options.ToggleKey or Enum.KeyCode.RightShift,
		Mode = "Toggle",
		Flag = "NebulaMenuKey",
		Callback = function()
			self:Toggle()
		end,
	})

	local config = tab:CreateSection("Configuration")
	local nameBox = config:CreateTextbox({
		Name = "Configuration name",
		Placeholder = "my-config",
		FireOnInit = false,
	})
	local listBox
	listBox = config:CreateDropdown({
		Name = "Saved configurations",
		Options = self:ListConfigs(),
		Search = false,
	})
	local jsonBox = config:CreateTextbox({
		Name = "Config JSON",
		Description = "Export fills this box. Paste JSON here and press Import to apply it.",
		Placeholder = "{ ... }",
		FireOnInit = false,
	})
	local function refreshList()
		listBox:SetOptions(self:ListConfigs())
	end
	config:CreateButton({
		Name = "Save",
		Description = "Store the current settings under the name above.",
		ButtonText = "Save",
		Callback = function()
			local name = nameBox:GetValue()
			if name == "" then
				name = listBox:GetValue() or ""
			end
			local ok, err = self:SaveConfig(name)
			if ok then
				refreshList()
				listBox:SetValue(name, true)
				self:Notify({ Title = "Configuration saved", Description = name, Type = "success" })
			else
				self:Notify({ Title = "Could not save", Description = err, Type = "error" })
			end
		end,
	})
	config:CreateButton({
		Name = "Load",
		Description = "Apply the configuration selected in the list.",
		ButtonText = "Load",
		Callback = function()
			local name = listBox:GetValue()
			if not name then
				self:Notify({ Title = "Nothing selected", Description = "Pick a saved configuration first.", Type = "warning" })
				return
			end
			local ok, err = self:LoadConfig(name)
			if ok then
				self:Notify({ Title = "Configuration loaded", Description = name, Type = "success" })
			else
				self:Notify({ Title = "Could not load", Description = err, Type = "error" })
			end
		end,
	})
	config:CreateButton({
		Name = "Delete",
		Description = "Remove the selected configuration.",
		ButtonText = "Delete",
		Callback = function()
			local name = listBox:GetValue()
			if name then
				self:DeleteConfig(name)
				refreshList()
				self:Notify({ Title = "Configuration deleted", Description = name, Type = "warning" })
			end
		end,
	})
	config:CreateButton({
		Name = "Export",
		Description = "Write the current settings as JSON into the box above.",
		ButtonText = "Export",
		Callback = function()
			jsonBox:SetValue(self:ExportConfig(), true)
			self:Notify({ Title = "Configuration exported", Description = "JSON written to the box.", Type = "info" })
		end,
	})
	config:CreateButton({
		Name = "Import",
		Description = "Apply the JSON currently in the box.",
		ButtonText = "Import",
		Callback = function()
			local ok, err = self:ImportConfig(jsonBox:GetValue())
			if ok then
				self:Notify({ Title = "Configuration imported", Type = "success" })
			else
				self:Notify({ Title = "Import failed", Description = err, Type = "error" })
			end
		end,
	})

	local session = tab:CreateSection("Session")
	session:CreateButton({
		Name = "Reset appearance",
		Description = "Back to the default theme, accent and scale.",
		ButtonText = "Reset",
		Callback = function()
			self:SetTheme("Dark")
			self:SetAccent(self.Options.AccentColor or Color3.fromRGB(124, 92, 255))
			self:SetScale(1)
		end,
	})
	session:CreateButton({
		Name = "Unload interface",
		Description = "Destroy the interface and disconnect every event.",
		ButtonText = "Unload",
		Callback = function()
			self:Destroy()
		end,
	})
end

function Library:_buildAbout()
	local tab = Tab.new(self, {
		Name = "About",
		Icon = "info",
		Kind = "About",
		Bottom = true,
		Order = 2,
		Description = "Information about this interface and the people behind it.",
	})
	self.AboutTab = tab
	local aboutOptions = type(self.Options.About) == "table" and self.Options.About or {}

	local app = tab:CreateSection(self.Name)
	app:CreateParagraph({
		Title = "Version " .. self.AppVersion,
		Content = aboutOptions.Description or self.Description,
	})
	local credits = tab:CreateSection("Credits")
	credits:CreateParagraph({ Title = "Developer", Content = self.Developer })
	if #self.Credits > 0 then
		credits:CreateParagraph({ Title = "Contributors", Content = table.concat(self.Credits, "\n") })
	end
	local about = tab:CreateSection("Nebula UI")
	about:CreateParagraph({
		Title = "Library " .. Library.Version,
		Content = "Native Roblox instances, TweenService animations and UserInputService input. "
			.. "Includes buttons, toggles, sliders, dropdowns, textboxes, keybinds, colour pickers, "
			.. "notifications, themes and configuration management.",
	})
end

----------------------------------------------------------------------
-- Constructor
----------------------------------------------------------------------

--[[
	Library.new({
		Name, Subtitle, Version, Theme ("Dark"|"Graphite"|"Midnight"), AccentColor,
		Username, Developer, Credits = {..}, Description, Logo (letter),
		Size = Vector2, MinSize = Vector2, Resizable = true, ToggleKey = Enum.KeyCode,
		ConfigProvider = { Save, Load, Delete, List }, Parent = Instance,
		Settings = true, About = true | { Description = "..." }
	})
]]
function Library.new(options)
	options = options or {}
	local self = setmetatable({}, Library)
	self.Options = options
	self.Name = tostring(options.Name or "Nebula UI")
	self.Subtitle = tostring(options.Subtitle or "Premium Interface")
	self.AppVersion = tostring(options.Version or "1.0.0")
	local player = Players.LocalPlayer
	self.Username = tostring(options.Username or (player and player.DisplayName) or "Guest")
	self.Developer = tostring(options.Developer or "Unknown")
	self.Credits = options.Credits or {}
	self.Description = tostring(options.Description or "A premium control panel for your experience. Browse the tabs on the left to get started.")

	self.Maid = Maid.new()
	self.Flags = {}
	self.Visible = false
	self.Minimized = false
	self.Destroyed = false
	self._flagObjects = {}
	self._bindings = {}
	self._tabs = {}
	self._allTabs = {}
	self._keybinds = {}
	self._toggles = {}
	self._notifs = {}
	self._notifId = 0
	self._activity = {}
	self._componentCount = 0
	self._tabOrder = 10
	self._visToken = 0
	self._startTime = os.clock()
	self._ui = {}

	local themeName = options.Theme
	if not Themes[themeName] then
		themeName = "Dark"
	end
	self.Settings = {
		Theme = themeName,
		Accent = typeof(options.AccentColor) == "Color3" and options.AccentColor or Color3.fromRGB(124, 92, 255),
		Scale = 1,
		Animations = true,
		AnimSpeed = 1,
		Notifications = true,
	}
	self.ConfigProvider = options.ConfigProvider or memoryProvider()
	self:_resolveTheme()

	local parent = options.Parent or (player and player:WaitForChild("PlayerGui"))
	assert(parent, "NebulaUI: no valid parent for the ScreenGui (run this from a LocalScript)")
	self.Gui = New("ScreenGui", {
		Name = "NebulaUI_" .. string.gsub(self.Name, "%W", ""),
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
		DisplayOrder = options.DisplayOrder or 100,
		Parent = parent,
	})
	self.Maid:Give(self.Gui)
	self.Root = New("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = self.Gui,
	})
	self.RootScale = New("UIScale", { Scale = 1, Parent = self.Root })

	self:_buildWindow()
	self:_buildNotifications()
	self:_connectInput()
	if options.Settings ~= false then
		self:_buildSettings()
	end
	if options.About ~= false then
		self:_buildAbout()
	end
	self:_updateScale()
	self:SetVisible(true)
	return self
end

return Library
