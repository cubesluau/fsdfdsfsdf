-- Faux ambient glow made from stacked translucent circles (no external assets needed).
local function Glow(lib, parent, position, radius, alpha, colorKey)
	local holder = New("Frame", {
		Name = "Glow",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		Size = UDim2.fromOffset(radius * 2, radius * 2),
		Parent = parent,
	})
	local steps = 8
	for i = 1, steps do
		local d = radius * 2 * (i / steps)
		local ring = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(d, d),
			BackgroundTransparency = 1 - alpha,
			Parent = holder,
		})
		Corner(math.floor(d / 2), ring)
		lib:Style(ring, { BackgroundColor3 = colorKey })
	end
end

function Library:_drag(handle, onBegan, onMoved)
	local moveConn, endConn, origin
	local function stop()
		if moveConn then
			moveConn:Disconnect()
			moveConn = nil
		end
		if endConn then
			endConn:Disconnect()
			endConn = nil
		end
	end
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			stop()
			origin = input.Position
			local context = onBegan()
			moveConn = UserInputService.InputChanged:Connect(function(changed)
				if changed.UserInputType == Enum.UserInputType.MouseMovement or changed.UserInputType == Enum.UserInputType.Touch then
					local delta = (changed.Position - origin) / self._scale
					onMoved(Vector2.new(delta.X, delta.Y), context)
				end
			end)
			endConn = UserInputService.InputEnded:Connect(function(ended)
				if ended.UserInputType == Enum.UserInputType.MouseButton1 or ended.UserInputType == Enum.UserInputType.Touch then
					stop()
				end
			end)
		end
	end)
	self.Maid:Give(stop)
end

function Library:_clampPos(pos)
	local vp = self._vp
	return Vector2.new(
		math.clamp(pos.X, 80 - self._size.X, math.max(vp.X - 80, 0)),
		math.clamp(pos.Y, 0, math.max(vp.Y - TITLE_H, 0))
	)
end

function Library:_setPosition(pos)
	self._pos = self:_clampPos(pos)
	self.Holder.Position = UDim2.fromOffset(self._pos.X, self._pos.Y)
end

function Library:_updateScale()
	if not self.Root then
		return
	end
	local abs = self.Gui.AbsoluteSize
	if abs.X < 1 or abs.Y < 1 then
		local camera = workspace.CurrentCamera
		abs = camera and camera.ViewportSize or Vector2.new(1280, 720)
	end
	local fit = math.min(abs.X / (self._size.X + 24), abs.Y / (self._size.Y + 24))
	local scale = math.max(math.min(self.Settings.Scale, fit), 0.4)
	self._scale = scale
	self.RootScale.Scale = scale
	self.Root.Size = UDim2.fromScale(1 / scale, 1 / scale)
	self._vp = Vector2.new(abs.X / scale, abs.Y / scale)
	if self.Holder then
		self:_setPosition(self._pos)
	end
end

