-- Builds the standard row (background, border, title, optional description).
-- Returns { Row, Header, Text, Title, Desc }.
local function CreateRow(section, opts, rightWidth, stacked, flat)
	local lib = section.Library
	local row = New("Frame", {
		Name = tostring(opts.Name or "Row"),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = AUTO_Y,
		BackgroundTransparency = flat and 1 or 0.2,
		LayoutOrder = section:_nextOrder(),
		Parent = section.Body,
	})
	Corner(8, row)
	lib:Style(row, { BackgroundColor3 = "SurfaceAlt" })
	if not flat then
		lib:Stroke(row, 0.45)
	end
	List(0, row)

	local header = New("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = AUTO_Y,
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = row,
	})
	if flat then
		Pad(4, 4, 4, 4, header)
	else
		Pad(10, 12, 10, 12, header)
	end
	if stacked then
		List(8, header)
	end

	local reserve = rightWidth and (rightWidth + 10) or 0
	local text = New("Frame", {
		Name = "Text",
		Size = UDim2.new(1, -reserve, 0, 0),
		AutomaticSize = AUTO_Y,
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = header,
	})
	List(2, text)
	local title = New("TextLabel", {
		Name = "Title",
		Size = UDim2.new(1, 0, 0, 16),
		Text = tostring(opts.Name or ""),
		TextXAlignment = LEFT,
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 1,
		Parent = text,
	})
	lib:Style(title, { TextColor3 = "Text" })

	local desc
	local description = opts.Description
	if description ~= nil and (description ~= "" or opts._keepDesc) then
		desc = New("TextLabel", {
			Name = "Description",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = AUTO_Y,
			Text = tostring(description),
			TextWrapped = true,
			TextXAlignment = LEFT,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextSize = 12,
			Font = Enum.Font.Gotham,
			LayoutOrder = 2,
			Parent = text,
		})
		lib:Style(desc, { TextColor3 = "SubText" })
	end
	return { Row = row, Header = header, Text = text, Title = title, Desc = desc }
end

-- Invisible button covering the whole header (including its padding).
local function FullHit(header)
	return New("TextButton", {
		Name = "Hit",
		Position = UDim2.fromOffset(-12, -10),
		Size = UDim2.new(1, 24, 1, 20),
		ZIndex = 10,
		Parent = header,
	})
end

local function BindRowHover(lib, row, hit, state)
	lib:_bind(row, function(theme)
		return {
			BackgroundColor3 = state.down and theme.SurfaceActive or (state.hover and theme.SurfaceHover or theme.SurfaceAlt),
		}
	end)
	hit.MouseEnter:Connect(function()
		state.hover = true
		lib:Refresh(row, 0.12)
	end)
	hit.MouseLeave:Connect(function()
		state.hover = false
		state.down = false
		lib:Refresh(row, 0.12)
	end)
	hit.MouseButton1Down:Connect(function()
		state.down = true
		lib:Refresh(row, 0.06)
	end)
	hit.MouseButton1Up:Connect(function()
		state.down = false
		lib:Refresh(row, 0.12)
	end)
end

-- Common finishing step: adds Destroy / SetVisible and bookkeeping.
local function Finish(section, obj, row, maid, onDestroy)
	obj.Instance = row
	obj.Section = section
	function obj:SetVisible(visible)
		row.Visible = visible and true or false
	end
	function obj:Destroy()
		if obj._destroyed then
			return
		end
		obj._destroyed = true
		maid:Clean()
		if onDestroy then
			onDestroy()
		end
		local list = section._components
		local index = table.find(list, obj)
		if index then
			table.remove(list, index)
		end
		row:Destroy()
	end
	return obj
end

local function fireInit(opts, ...)
	if opts.FireOnInit ~= false and opts.Callback then
		task.defer(safeCall, opts.Callback, ...)
	end
end

-- Button -------------------------------------------------------------------------------------------
Components.Button = function(section, opts)
	local lib = section.Library
	local maid = Maid.new()
	local obj = { Type = "Button", Name = opts.Name }
	local r = CreateRow(section, opts, 64)
	local state = { hover = false, down = false }

	local pill = New("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(64, 24),
		Parent = r.Header,
	})
	Corner(6, pill)
	lib:_bind(pill, function(theme)
		return { BackgroundColor3 = state.down and theme.AccentDark or theme.Accent }
	end)
	local pillLabel = New("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		Text = tostring(opts.ButtonText or "Run"),
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		Parent = pill,
	})
	lib:Style(pillLabel, { TextColor3 = "OnAccent" })

	local hit = FullHit(r.Header)
	BindRowHover(lib, r.Row, hit, state)
	hit.MouseButton1Down:Connect(function()
		lib:Refresh(pill, 0.06)
	end)
	hit.MouseButton1Up:Connect(function()
		lib:Refresh(pill, 0.12)
	end)
	hit.MouseLeave:Connect(function()
		lib:Refresh(pill, 0.12)
	end)
	hit.Activated:Connect(function()
		lib:LogActivity("Ran " .. tostring(opts.Name), "info")
		safeCall(opts.Callback)
	end)

	function obj:SetName(text)
		r.Title.Text = tostring(text)
	end
	function obj:Fire()
		safeCall(opts.Callback)
	end
	return Finish(section, obj, r.Row, maid)
end

-- Toggle -------------------------------------------------------------------------------------------
Components.Toggle = function(section, opts)
	local lib = section.Library
	local maid = Maid.new()
	local obj = { Type = "Toggle", Name = opts.Name }
	local value = opts.Default == true
	local r = CreateRow(section, opts, 46)
	local state = { hover = false, down = false }

	local track = New("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(40, 22),
		Parent = r.Header,
	})
	Corner(11, track)
	lib:_bind(track, function(theme)
		return { BackgroundColor3 = value and theme.Accent or theme.Border }
	end)
	local knob = New("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = value and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = track,
	})
	Corner(8, knob)

	local hit = FullHit(r.Header)
	BindRowHover(lib, r.Row, hit, state)

	function obj:GetValue()
		return value
	end
	function obj:SetValue(newValue, silent)
		newValue = newValue == true
		if newValue == value then
			return
		end
		value = newValue
		lib:Refresh(track, 0.2)
		lib:Tween(knob, 0.25, {
			Position = value and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		}, Enum.EasingStyle.Back)
		lib:_setFlag(opts.Flag, value)
		lib:_queueHome()
		if not silent then
			lib:LogActivity(tostring(opts.Name) .. (value and " enabled" or " disabled"), value and "success" or "info")
			safeCall(opts.Callback, value)
		end
	end
	function obj:_serialize()
		return value
	end
	function obj:_deserialize(v)
		obj:SetValue(v == true)
	end
	hit.Activated:Connect(function()
		obj:SetValue(not value)
	end)

	lib._toggles[obj] = true
	lib:_registerFlag(opts.Flag, obj)
	fireInit(opts, value)
	return Finish(section, obj, r.Row, maid, function()
		lib._toggles[obj] = nil
		if opts.Flag then
			lib._flagObjects[opts.Flag] = nil
		end
		lib:_queueHome()
	end)
end

-- Slider (shared drag control) ---------------------------------------------------------------------
local function CreateSliderControl(lib, props, cfg, scroller)
	local min, max, increment = cfg.Min, cfg.Max, cfg.Increment or 1
	local value = snap(cfg.Value or min, min, max, increment)
	local range = math.max(max - min, 1e-9)
	local ctl = {}

	local hit = New("TextButton", props)
	local track = New("Frame", {
		Name = "Track",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(7, 0),
		Size = UDim2.new(1, -14, 1, 0),
		Parent = hit,
	})
	local bar = New("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, 0, 0, 6),
		Parent = track,
	})
	Corner(3, bar)
	lib:Style(bar, { BackgroundColor3 = "Border" })

	local alpha = (value - min) / range
	local fill = New("Frame", {
		Size = UDim2.new(alpha, 0, 1, 0),
		Parent = bar,
	})
	Corner(3, fill)
	if cfg.FillColor then
		fill.BackgroundColor3 = cfg.FillColor
	else
		lib:Style(fill, { BackgroundColor3 = "Accent" })
	end

	local knob = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(alpha, 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = track,
	})
	Corner(7, knob)
	if cfg.FillColor then
		local stroke = New("UIStroke", { Color = cfg.FillColor, Thickness = 2, Parent = knob })
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	else
		lib:Stroke(knob, 0, "Accent", 2)
	end

	function ctl.Set(newValue, silent)
		newValue = snap(newValue, min, max, increment)
		if newValue == value then
			return
		end
		value = newValue
		local a = (value - min) / range
		lib:Tween(fill, 0.08, { Size = UDim2.new(a, 0, 1, 0) }, Enum.EasingStyle.Quad)
		lib:Tween(knob, 0.08, { Position = UDim2.new(a, 0, 0.5, 0) }, Enum.EasingStyle.Quad)
		if not silent and cfg.OnChanged then
			cfg.OnChanged(value)
		end
	end
	function ctl.Get()
		return value
	end
	ctl.Hit = hit

	local dragging = false
	local moveConn, endConn
	local function stop()
		dragging = false
		if moveConn then
			moveConn:Disconnect()
			moveConn = nil
		end
		if endConn then
			endConn:Disconnect()
			endConn = nil
		end
		if scroller and scroller.Parent then
			scroller.ScrollingEnabled = true
		end
	end
	local function fromInput(input)
		local rel = (input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
		ctl.Set(min + range * math.clamp(rel, 0, 1), false)
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			stop()
			dragging = true
			if scroller then
				scroller.ScrollingEnabled = false
			end
			fromInput(input)
			moveConn = UserInputService.InputChanged:Connect(function(changed)
				if dragging and (changed.UserInputType == Enum.UserInputType.MouseMovement or changed.UserInputType == Enum.UserInputType.Touch) then
					fromInput(changed)
				end
			end)
			endConn = UserInputService.InputEnded:Connect(function(ended)
				if ended.UserInputType == Enum.UserInputType.MouseButton1 or ended.UserInputType == Enum.UserInputType.Touch then
					stop()
				end
			end)
		end
	end)
	hit.Destroying:Connect(stop)
	return ctl
end

Components.Slider = function(section, opts)
	local lib = section.Library
	local maid = Maid.new()
	local obj = { Type = "Slider", Name = opts.Name }
	local min, max = opts.Min or 0, opts.Max or 100
	local increment = opts.Increment or 1
	local suffix = opts.Suffix or ""
	local decimals = decimalsOf(increment)
	local value = snap(opts.Default or min, min, max, increment)

	local function format(v)
		return string.format("%." .. decimals .. "f", v) .. suffix
	end

	local r = CreateRow(section, opts, nil, true)
	local box = New("TextBox", {
		Name = "Value",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(78, 20),
		BackgroundTransparency = 1,
		Text = format(value),
		TextXAlignment = RIGHT,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		Parent = r.Title,
	})
	lib:Style(box, { TextColor3 = "Accent" })

	local ctl
	ctl = CreateSliderControl(lib, {
		Name = "Slider",
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = 2,
		Parent = r.Header,
	}, {
		Min = min,
		Max = max,
		Increment = increment,
		Value = value,
		OnChanged = function(v)
			value = v
			box.Text = format(v)
			lib:_setFlag(opts.Flag, v)
			safeCall(opts.Callback, v)
		end,
	}, section.Scroll)

	function obj:GetValue()
		return value
	end
	function obj:SetValue(newValue, silent)
		newValue = snap(tonumber(newValue) or value, min, max, increment)
		value = newValue
		ctl.Set(newValue, true)
		box.Text = format(value)
		lib:_setFlag(opts.Flag, value)
		if not silent then
			safeCall(opts.Callback, value)
		end
	end
	function obj:_serialize()
		return value
	end
	function obj:_deserialize(v)
		obj:SetValue(v)
	end

	box.FocusLost:Connect(function()
		local number = tonumber(string.match(box.Text, "-?%d+%.?%d*"))
		if number then
			obj:SetValue(number)
		else
			box.Text = format(value)
		end
	end)

	lib:_registerFlag(opts.Flag, obj)
	fireInit(opts, value)
	return Finish(section, obj, r.Row, maid, function()
		if opts.Flag then
			lib._flagObjects[opts.Flag] = nil
		end
	end)
end

-- Dropdown -------------------------------------------------------------------------------------------
Components.Dropdown = function(section, opts)
	local lib = section.Library
	local maid = Maid.new()
	local obj = { Type = "Dropdown", Name = opts.Name }
	local multi = opts.Multi == true
	local options, selected, buttons = {}, {}, {}
	local open = false
	for _, option in ipairs(opts.Options or {}) do
		table.insert(options, tostring(option))
	end
	local searchable = opts.Search == true or (opts.Search ~= false and #options > 6)

	local r = CreateRow(section, opts, 170)
	local state = { hover = false, down = false }

	local valueLabel = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -20, 0.5, 0),
		Size = UDim2.fromOffset(150, 18),
		TextXAlignment = RIGHT,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextSize = 12,
		Parent = r.Header,
	})
	lib:Style(valueLabel, { TextColor3 = "Accent" })
	local chevron = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		Text = "›",
		TextSize = 20,
		Rotation = 90,
		Font = Enum.Font.GothamBold,
		Parent = r.Header,
	})
	lib:Style(chevron, { TextColor3 = "SubText" })

	local body = New("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 2,
		Visible = false,
		Parent = r.Row,
	})
	local inner = New("Frame", {
		Name = "Inner",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -24, 0, 0),
		Parent = body,
	})
	List(6, inner)

	local search
	if searchable then
		search = New("TextBox", {
			Name = "Search",
			Size = UDim2.new(1, 0, 0, 28),
			PlaceholderText = "Search...",
			Text = "",
			ClearTextOnFocus = false,
			TextXAlignment = LEFT,
			TextSize = 12,
			Font = Enum.Font.Gotham,
			LayoutOrder = 1,
			Parent = inner,
		})
		Corner(6, search)
		Pad(0, 8, 0, 8, search)
		lib:Style(search, { BackgroundColor3 = "Surface", TextColor3 = "Text", PlaceholderColor3 = "Muted" })
		lib:Stroke(search, 0.3)
	end

	local list = New("ScrollingFrame", {
		Name = "List",
		Size = UDim2.new(1, 0, 0, 0),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = AUTO_Y,
		ScrollBarThickness = 2,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		LayoutOrder = 2,
		Parent = inner,
	})
	lib:Style(list, { ScrollBarImageColor3 = "Muted" })
	List(2, list)
	local emptyLabel = New("TextLabel", {
		Size = UDim2.new(1, 0, 0, 26),
		Text = "No results",
		TextSize = 12,
		Font = Enum.Font.Gotham,
		Visible = false,
		Parent = list,
	})
	lib:Style(emptyLabel, { TextColor3 = "Muted" })

	local function layoutHeights()
		local count = 0
		for _, name in ipairs(options) do
			if buttons[name] and buttons[name].Frame.Visible then
				count = count + 1
			end
		end
		emptyLabel.Visible = count == 0
		local listHeight = count == 0 and 28 or math.min(count * 30, 150)
		list.Size = UDim2.new(1, 0, 0, listHeight)
		local innerHeight = listHeight + (search and 34 or 0)
		inner.Size = UDim2.new(1, -24, 0, innerHeight)
		return innerHeight + 12
	end

	local function updateDisplay()
		local names = {}
		for _, name in ipairs(options) do
			if selected[name] then
				table.insert(names, name)
			end
		end
		if #names == 0 then
			valueLabel.Text = multi and "None" or "Select..."
		elseif multi and #names > 2 then
			valueLabel.Text = #names .. " selected"
		else
			valueLabel.Text = table.concat(names, ", ")
		end
	end

	local function refreshButtons()
		for _, entry in pairs(buttons) do
			lib:Refresh(entry.Frame, 0.12)
			lib:Refresh(entry.Label, 0.12)
			lib:Refresh(entry.Dot, 0.12)
		end
	end

	local function applyFilter()
		local query = search and string.lower(search.Text) or ""
		for _, name in ipairs(options) do
			local entry = buttons[name]
			if entry then
				entry.Frame.Visible = query == "" or string.find(string.lower(name), query, 1, true) ~= nil
			end
		end
		local height = layoutHeights()
		if open then
			lib:Tween(body, 0.2, { Size = UDim2.new(1, 0, 0, height) })
		end
	end

	local function setOpen(value)
		open = value
		if value then
			body.Visible = true
			lib:Tween(body, 0.3, { Size = UDim2.new(1, 0, 0, layoutHeights()) })
		else
			lib:Tween(body, 0.22, { Size = UDim2.new(1, 0, 0, 0) }, nil, nil, function()
				if not open then
					body.Visible = false
				end
			end)
		end
		lib:Tween(chevron, 0.22, { Rotation = value and -90 or 90 })
	end

	function obj:GetValue()
		if multi then
			local values = {}
			for _, name in ipairs(options) do
				if selected[name] then
					table.insert(values, name)
				end
			end
			return values
		end
		for _, name in ipairs(options) do
			if selected[name] then
				return name
			end
		end
		return nil
	end

	local function commit(silent)
		updateDisplay()
		refreshButtons()
		local value = obj:GetValue()
		lib:_setFlag(opts.Flag, value)
		if not silent then
			safeCall(opts.Callback, value)
		end
	end

	local function choose(name)
		if multi then
			selected[name] = (not selected[name]) or nil
		else
			table.clear(selected)
			selected[name] = true
		end
		commit(false)
		if not multi then
			setOpen(false)
		end
	end

	local function rebuild()
		for _, entry in pairs(buttons) do
			entry.Frame:Destroy()
		end
		table.clear(buttons)
		for index, name in ipairs(options) do
			local hover = false
			local frame = New("TextButton", {
				Name = name,
				Size = UDim2.new(1, 0, 0, 28),
				LayoutOrder = index,
				Parent = list,
			})
			Corner(6, frame)
			lib:_bind(frame, function(theme)
				if selected[name] then
					return { BackgroundColor3 = theme.Accent, BackgroundTransparency = hover and 0.72 or 0.84 }
				end
				return { BackgroundColor3 = theme.SurfaceHover, BackgroundTransparency = hover and 0.4 or 1 }
			end)
			local label = New("TextLabel", {
				Position = UDim2.fromOffset(10, 0),
				Size = UDim2.new(1, -30, 1, 0),
				Text = name,
				TextXAlignment = LEFT,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextSize = 12,
				Parent = frame,
			})
			lib:_bind(label, function(theme)
				return { TextColor3 = selected[name] and theme.Text or theme.SubText }
			end)
			local dot = New("Frame", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(8, 8),
				Parent = frame,
			})
			Corner(4, dot)
			lib:_bind(dot, function(theme)
				return { BackgroundColor3 = theme.Accent, BackgroundTransparency = selected[name] and 0 or 1 }
			end)
			frame.MouseEnter:Connect(function()
				hover = true
				lib:Refresh(frame, 0.1)
			end)
			frame.MouseLeave:Connect(function()
				hover = false
				lib:Refresh(frame, 0.1)
			end)
			frame.Activated:Connect(function()
				choose(name)
			end)
			buttons[name] = { Frame = frame, Label = label, Dot = dot }
		end
		applyFilter()
	end

	function obj:SetValue(value, silent)
		table.clear(selected)
		if multi then
			local set = type(value) == "table" and value or (value ~= nil and { value } or {})
			for _, name in ipairs(set) do
				name = tostring(name)
				if table.find(options, name) then
					selected[name] = true
				end
			end
		elseif value ~= nil then
			value = tostring(value)
			if table.find(options, value) then
				selected[value] = true
			end
		end
		commit(silent)
	end

	function obj:SetOptions(newOptions)
		options = {}
		for _, option in ipairs(newOptions or {}) do
			table.insert(options, tostring(option))
		end
		for name in pairs(selected) do
			if not table.find(options, name) then
				selected[name] = nil
			end
		end
		rebuild()
		commit(true)
	end

	function obj:_serialize()
		return obj:GetValue()
	end
	function obj:_deserialize(value)
		obj:SetValue(value)
	end

	if search then
		search:GetPropertyChangedSignal("Text"):Connect(applyFilter)
	end
	local hit = FullHit(r.Header)
	BindRowHover(lib, r.Row, hit, state)
	hit.Activated:Connect(function()
		setOpen(not open)
	end)

	rebuild()
	local default = opts.Default
	if default ~= nil then
		obj:SetValue(default, true)
	else
		updateDisplay()
	end
	lib:_registerFlag(opts.Flag, obj)
	if default ~= nil then
		fireInit(opts, obj:GetValue())
	end
	return Finish(section, obj, r.Row, maid, function()
		if opts.Flag then
			lib._flagObjects[opts.Flag] = nil
		end
	end)
end

