function Library:SetVisible(visible)
	visible = visible and true or false
	if self.Visible == visible then
		return
	end
	self.Visible = visible
	self._visToken = self._visToken + 1
	local token = self._visToken
	local target = UDim2.fromOffset(self._pos.X, self._pos.Y)
	self.MobileButton.Visible = (not visible) and UserInputService.TouchEnabled

	if visible then
		self.Holder.Visible = true
		self.Holder.Position = target + UDim2.fromOffset(0, 18)
		self.Window.GroupTransparency = 1
		self:Tween(self.Holder, 0.45, { Position = target }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		self:Tween(self.Window, 0.3, { GroupTransparency = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		for _, shadow in ipairs(self._shadows) do
			self:Tween(shadow.Frame, 0.4, { BackgroundTransparency = shadow.Target }, Enum.EasingStyle.Quad)
		end
	else
		self:Tween(self.Holder, 0.25, { Position = target + UDim2.fromOffset(0, 18) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		self:Tween(self.Window, 0.22, { GroupTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In, function()
			if self._visToken == token then
				self.Holder.Visible = false
				self.Holder.Position = target
			end
		end)
		for _, shadow in ipairs(self._shadows) do
			self:Tween(shadow.Frame, 0.2, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
		end
	end
end

function Library:Toggle()
	self:SetVisible(not self.Visible)
end

function Library:SetMinimized(minimized)
	self.Minimized = minimized and true or false
	local height = self.Minimized and TITLE_H or self._size.Y
	self:Tween(self.Holder, 0.35, { Size = UDim2.fromOffset(self._size.X, height) }, Enum.EasingStyle.Quint)
	if self.Grip then
		self.Grip.Visible = not self.Minimized
	end
end

function Library:_connectInput()
	self.Maid:Give(UserInputService.InputBegan:Connect(function(input, processed)
		if processed or input.UserInputType ~= Enum.UserInputType.Keyboard or self._listening then
			return
		end
		for obj in pairs(self._keybinds) do
			obj:_press(input.KeyCode)
		end
	end))
	self.Maid:Give(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		for obj in pairs(self._keybinds) do
			obj:_release(input.KeyCode)
		end
	end))
	self.Maid:Give(self.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:_updateScale()
	end))
end

function Library:Destroy()
	if self.Destroyed then
		return
	end
	self.Destroyed = true
	self.Maid:Clean()
	table.clear(self._bindings)
	table.clear(self._keybinds)
	table.clear(self._toggles)
	table.clear(self._flagObjects)
end

