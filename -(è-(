			Text = glyph,
			TextSize = 18,
			Font = Enum.Font.GothamBold,
			Parent = button,
		})
		self:_bind(label, function(theme)
			return { TextColor3 = (hovered and hoverKey == "Error") and theme.Error or theme.SubText }
		end)
		button.MouseEnter:Connect(function()
			hovered = true
			self:Refresh(button, 0.12)
			self:Refresh(label, 0.12)
		end)
		button.MouseLeave:Connect(function()
			hovered = false
