-- ColorPicker -------------------------------------------------------------------------------------------
Components.ColorPicker = function(section, opts)
	local lib = section.Library
	local maid = Maid.new()
	local obj = { Type = "ColorPicker", Name = opts.Name }
	local color = typeof(opts.Default) == "Color3" and opts.Default or Color3.fromRGB(255, 255, 255)
	local open = false
	local state = { hover = false, down = false }

	local r = CreateRow(section, opts, 56)
	local swatch = New("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(40, 22),
		BackgroundColor3 = color,
		Parent = r.Header,
	})
	Corner(6, swatch)
	lib:Stroke(swatch, 0.2)

	local BODY_INNER = 114
	local body = New("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 2,
		Visible = false,
		Parent = r.Row,
	})
	local inner = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -24, 0, BODY_INNER),
		Parent = body,
	})
	List(6, inner)

	-- Preview + hex
	local top = New("Frame", { Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, LayoutOrder = 1, Parent = inner })
	local preview = New("Frame", {
		Size = UDim2.fromOffset(36, 36),
		BackgroundColor3 = color,
		Parent = top,
	})
	Corner(8, preview)
	lib:Stroke(preview, 0.2)
	local hexBox = New("TextBox", {
		Position = UDim2.fromOffset(46, 4),
		Size = UDim2.fromOffset(110, 28),
		BackgroundTransparency = 0,
		Text = "",
		PlaceholderText = "#RRGGBB",
		ClearTextOnFocus = false,
		TextSize = 12,
		Font = Enum.Font.GothamMedium,
		Parent = top,
	})
	Corner(6, hexBox)
	Pad(0, 8, 0, 8, hexBox)
	lib:Style(hexBox, { BackgroundColor3 = "Surface", TextColor3 = "Text", PlaceholderColor3 = "Muted" })
	local hexStroke = lib:Stroke(hexBox, 0.3)
	local hexInvalid = false
	lib:_bind(hexStroke, function(theme)
		return { Color = hexInvalid and theme.Error or theme.Border }
	end)

	local channelColors = { Color3.fromRGB(255, 90, 90), Color3.fromRGB(90, 220, 130), Color3.fromRGB(90, 150, 255) }
	local channelNames = { "R", "G", "B" }
	local sliders, valueLabels = {}, {}

	local function to255(value)
		return math.floor(value * 255 + 0.5)
	end

	local applying = false
	local function applyColor(newColor, silent, fromSliders)
		color = newColor
		swatch.BackgroundColor3 = color
		preview.BackgroundColor3 = color
		hexBox.Text = "#" .. color:ToHex()
		local components = { to255(color.R), to255(color.G), to255(color.B) }
		for index = 1, 3 do
			valueLabels[index].Text = tostring(components[index])
			if not fromSliders then
				sliders[index].Set(components[index], true)
			end
		end
		lib:_setFlag(opts.Flag, color)
		if not silent then
			safeCall(opts.Callback, color)
		end
	end

	for index = 1, 3 do
		local row = New("Frame", {
			Size = UDim2.new(1, 0, 0, 20),
			BackgroundTransparency = 1,
			LayoutOrder = index + 1,
			Parent = inner,
		})
		local letter = New("TextLabel", {
			Size = UDim2.fromOffset(14, 20),
			Text = channelNames[index],
			TextSize = 12,
			Font = Enum.Font.GothamBold,
			Parent = row,
		})
		lib:Style(letter, { TextColor3 = "SubText" })
		sliders[index] = CreateSliderControl(lib, {
			Position = UDim2.fromOffset(22, 1),
			Size = UDim2.new(1, -70, 0, 18),
			Parent = row,
		}, {
			Min = 0,
			Max = 255,
			Increment = 1,
			Value = to255(index == 1 and color.R or (index == 2 and color.G or color.B)),
			FillColor = channelColors[index],
			OnChanged = function()
				if applying then
					return
				end
				applyColor(Color3.fromRGB(sliders[1].Get(), sliders[2].Get(), sliders[3].Get()), false, true)
			end,
		}, section.Scroll)
		valueLabels[index] = New("TextLabel", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 0),
			Size = UDim2.fromOffset(34, 20),
			Text = "0",
			TextXAlignment = RIGHT,
			TextSize = 12,
			Parent = row,
		})
		lib:Style(valueLabels[index], { TextColor3 = "Text" })
	end

	hexBox.FocusLost:Connect(function()
		local hex = string.gsub(hexBox.Text, "[#%s]", "")
		if #hex == 6 and string.match(hex, "^%x+$") then
			hexInvalid = false
			applyColor(Color3.fromHex("#" .. hex), false, false)
		else
			hexInvalid = true
			lib:Refresh(hexStroke, 0.1)
			hexBox.Text = "#" .. color:ToHex()
			task.delay(0.9, function()
				hexInvalid = false
				if hexStroke.Parent then
					lib:Refresh(hexStroke, 0.25)
				end
			end)
		end
	end)

	function obj:GetValue()
		return color
	end
	function obj:SetValue(newColor, silent)
		if typeof(newColor) == "string" then
			local ok, parsed = pcall(Color3.fromHex, newColor)
			if ok then
				newColor = parsed
			end
		end
		if typeof(newColor) == "Color3" then
			applyColor(newColor, silent, false)
		end
	end
	function obj:_serialize()
		return color:ToHex()
	end
	function obj:_deserialize(value)
		obj:SetValue("#" .. tostring(value))
	end

	local hit = FullHit(r.Header)
	BindRowHover(lib, r.Row, hit, state)
	hit.Activated:Connect(function()
		open = not open
		if open then
			body.Visible = true
			lib:Tween(body, 0.3, { Size = UDim2.new(1, 0, 0, BODY_INNER + 12) })
		else
			lib:Tween(body, 0.22, { Size = UDim2.new(1, 0, 0, 0) }, nil, nil, function()
				if not open then
					body.Visible = false
				end
			end)
		end
	end)

	applying = true
	applyColor(color, true, false)
	applying = false
	lib:_registerFlag(opts.Flag, obj)
	fireInit(opts, color)
	return Finish(section, obj, r.Row, maid, function()
		if opts.Flag then
			lib._flagObjects[opts.Flag] = nil
		end
	end)
end

