	})

	local function chip(width, order)
		local button = New("TextButton", {
			Size = UDim2.fromOffset(width, 24),
			BackgroundTransparency = 0,
			TextSize = 11,
			LayoutOrder = order,
			Parent = holder,
		})
		Corner(6, button)
