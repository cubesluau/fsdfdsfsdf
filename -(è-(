function Library:_resolveTheme()
	local base = Themes[self.Settings.Theme] or Themes.Dark
	local theme = {}
	for key, value in pairs(base) do
		theme[key] = value
	end
	theme.Accent = self.Settings.Accent
	theme.AccentDark = self.Settings.Accent:Lerp(Color3.new(0, 0, 0), 0.45)
	self.Theme = theme
end

local TWEENABLE = { number = true, Color3 = true, UDim2 = true, Vector2 = true, UDim = true }

-- Applies a property table, tweening what can be tweened.
function Library:_apply(inst, props, duration)
	local tweenProps = {}
	local animate = self.Settings.Animations and duration and duration > 0
	for key, value in pairs(props) do
		if animate and TWEENABLE[typeof(value)] then
			tweenProps[key] = value
		else
			inst[key] = value
		end
	end
	if next(tweenProps) then
		local info = TweenInfo.new(duration / self.Settings.AnimSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(inst, info, tweenProps):Play()
	end
end

-- Binds an instance to the theme: fn(theme) returns a property table that is
-- re-applied whenever the theme changes or Library:Refresh(inst) is called.
function Library:_bind(inst, fn)
	self._bindings[inst] = fn
	self:_apply(inst, fn(self.Theme), 0)
	inst.Destroying:Connect(function()
		self._bindings[inst] = nil
	end)
	return inst
end

-- Shorthand: Style(inst, { BackgroundColor3 = "Surface" }) binds properties to theme keys.
function Library:Style(inst, map)
	return self:_bind(inst, function(theme)
		local props = {}
		for property, key in pairs(map) do
			props[property] = theme[key]
		end
		return props
	end)
end

function Library:Refresh(inst, duration)
	local fn = self._bindings[inst]
	if fn then
		self:_apply(inst, fn(self.Theme), duration or 0.16)
	end
end

function Library:Stroke(parent, transparency, key, thickness)
	local stroke = New("UIStroke", {
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
	self:Style(stroke, { Color = key or "Border" })
	return stroke
end

-- Central tween helper. Honours the Animations / Animation Speed settings.
function Library:Tween(inst, duration, props, style, direction, onComplete)
	if not self.Settings.Animations then
		for key, value in pairs(props) do
			inst[key] = value
		end
		if onComplete then
			task.defer(onComplete)
		end
		return nil
	end
	local info = TweenInfo.new(
		duration / math.max(self.Settings.AnimSpeed, 0.1),
		style or Enum.EasingStyle.Quint,
		direction or Enum.EasingDirection.Out
	)
	local tween = TweenService:Create(inst, info, props)
	if onComplete then
		local connection
		connection = tween.Completed:Connect(function()
			connection:Disconnect()
			onComplete()
		end)
	end
	tween:Play()
	return tween
end

function Library:_applyThemeAll()
	self:_resolveTheme()
	for inst, fn in pairs(self._bindings) do
		if inst:IsDescendantOf(self.Gui) then
			self:_apply(inst, fn(self.Theme), 0.3)
		else
			self._bindings[inst] = nil
		end
	end
end

-- Public: theme / accent / scale -------------------------------------------------

function Library:SetTheme(name)
	if not Themes[name] then
		return false
	end
	self.Settings.Theme = name
	self:_applyThemeAll()
	if self._ui and self._ui.Theme and self._ui.Theme:GetValue() ~= name then
		self._ui.Theme:SetValue(name, true)
	end
	self:LogActivity("Theme set to " .. name, "info")
	self:_queueHome()
	return true
end

function Library:SetAccent(color)
	if typeof(color) ~= "Color3" then
		return false
	end
	self.Settings.Accent = color
	self:_applyThemeAll()
	if self._ui and self._ui.Accent then
		self._ui.Accent:SetValue(color, true)
	end
	self:_queueHome()
	return true
end

function Library:SetScale(scale)
	self.Settings.Scale = math.clamp(scale, 0.5, 2)
	self:_updateScale()
	if self._ui and self._ui.Scale then
		self._ui.Scale:SetValue(string.format("%d%%", math.floor(self.Settings.Scale * 100 + 0.5)), true)
	end
	self:_queueHome()
end

function Library:RegisterTheme(name, theme)
	local merged = {}
	for key, value in pairs(Themes.Dark) do
		merged[key] = value
	end
	for key, value in pairs(theme) do
		merged[key] = value
	end
	if not Themes[name] then
		table.insert(ThemeOrder, name)
	end
	Themes[name] = merged
	if self._ui and self._ui.Theme then
		self._ui.Theme:SetOptions(ThemeOrder)
	end
end

function Library:RegisterComponent(name, builder)
	Components[name] = builder
end

-- Activity log / dashboard refresh --------------------------------------------------

function Library:LogActivity(text, kind)
	table.insert(self._activity, 1, { Text = text, Kind = kind or "info", Time = os.date("%H:%M:%S") })
	if #self._activity > 20 then
		table.remove(self._activity)
	end
	self:_queueHome()
end

function Library:_queueHome()
	if self._homeQueued or not self.Home then
		return
	end
	self._homeQueued = true
	task.defer(function()
		self._homeQueued = false
		if not self.Destroyed and self.Home then
			self.Home.Refresh()
		end
	end)
end

-- Flags & configuration -----------------------------------------------------------------

function Library:_registerFlag(flag, obj)
	if not flag then
		return
	end
	self._flagObjects[flag] = obj
	self.Flags[flag] = obj:GetValue()
end

function Library:_setFlag(flag, value)
	if flag then
		self.Flags[flag] = value
	end
end

function Library:ExportConfig()
	local data = {}
	for flag, obj in pairs(self._flagObjects) do
		local ok, value = pcall(obj._serialize, obj)
		if ok and value ~= nil then
			data[flag] = value
		end
	end
	return HttpService:JSONEncode({ Format = "NebulaUI", Version = 1, Flags = data })
end

function Library:ImportConfig(json)
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, json)
	if not ok or type(decoded) ~= "table" or type(decoded.Flags) ~= "table" then
		return false, "Invalid configuration data"
	end
	for flag, value in pairs(decoded.Flags) do
		local obj = self._flagObjects[flag]
		if obj then
			pcall(obj._deserialize, obj, value)
		end
	end
	return true
end

function Library:SaveConfig(name)
	if type(name) ~= "string" or name == "" then
		return false, "Enter a configuration name"
	end
	local ok, err = pcall(self.ConfigProvider.Save, name, self:ExportConfig())
	if not ok then
		return false, tostring(err)
	end
	self:LogActivity("Saved config '" .. name .. "'", "success")
	return true
end

function Library:LoadConfig(name)
	local ok, json = pcall(self.ConfigProvider.Load, name)
	if not ok or not json then
		return false, "Configuration not found"
	end
	local imported, err = self:ImportConfig(json)
	if imported then
		self:LogActivity("Loaded config '" .. tostring(name) .. "'", "success")
	end
	return imported, err
end

function Library:DeleteConfig(name)
	local ok = pcall(self.ConfigProvider.Delete, name)
	if ok then
		self:LogActivity("Deleted config '" .. tostring(name) .. "'", "warning")
	end
	return ok
end

function Library:ListConfigs()
	local ok, list = pcall(self.ConfigProvider.List)
	if ok and type(list) == "table" then
		return list
	end
	return {}
end

-- Notifications -----------------------------------------------------------------------------

function Library:_buildNotifications()
	self.NotifHolder = New("Frame", {
		Name = "Notifications",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -18, 1, -18),
		Size = UDim2.new(0, 300, 1, -36),
		ZIndex = 50,
		Parent = self.Root,
	})
	List(8, self.NotifHolder, nil, { VerticalAlignment = Enum.VerticalAlignment.Bottom })
end

--[[
	Library:Notify({
		Title = "Saved", Description = "Config saved", Type = "success"|"warning"|"error"|"info",
		Duration = 4, Icon = "rbxassetid://..." (optional)
	})
]]
function Library:Notify(opts)
	if self.Destroyed then
		return
	end
	if type(opts) == "string" then
		opts = { Title = opts }
	end
	opts = opts or {}
	if not self.Settings.Notifications and not opts.Force then
		return
	end

	local kind = string.lower(tostring(opts.Type or "info"))
	local colorKey = ({ success = "Success", warning = "Warning", error = "Error", info = "Info" })[kind]
	if not colorKey then
		kind, colorKey = "info", "Info"
	end
	local glyph = opts.Icon or ({ success = "✓", warning = "!", error = "×", info = "i" })[kind]
	local title = tostring(opts.Title or "Notification")
	local content = tostring(opts.Description or opts.Content or "")
	local duration = tonumber(opts.Duration) or 4

	local textWidth = 300 - 56 - 14
	local contentHeight = content ~= "" and textHeight(content, 12, Enum.Font.Gotham, textWidth) or 0
	local height = math.max(56, 12 + 16 + (contentHeight > 0 and (contentHeight + 4) or 0) + 16)

	self._notifId = self._notifId + 1
	local wrapper = New("Frame", {
		Name = "Notification",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height),
		LayoutOrder = self._notifId,
		Parent = self.NotifHolder,
	})
	local card = New("Frame", {
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.new(1, 40, 0, 0),
		BackgroundTransparency = 0.04,
		Parent = wrapper,
	})
	Corner(10, card)
	self:Style(card, { BackgroundColor3 = "Surface" })
	self:Stroke(card, 0.3)

	local bar = New("Frame", {
		Position = UDim2.fromOffset(0, 10),
		Size = UDim2.new(0, 3, 1, -20),
		Parent = card,
	})
	Corner(2, bar)
	self:Style(bar, { BackgroundColor3 = colorKey })

	local iconBg = New("Frame", {
		Position = UDim2.fromOffset(14, 12),
		Size = UDim2.fromOffset(28, 28),
		BackgroundTransparency = 0.8,
		Parent = card,
	})
	Corner(14, iconBg)
	self:Style(iconBg, { BackgroundColor3 = colorKey })
	local iconKind, iconValue = resolveIcon(glyph, title)
	local iconLabel
	if iconKind == "image" then
		iconLabel = New("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(16, 16),
			Image = iconValue,
			Parent = iconBg,
		})
		self:Style(iconLabel, { ImageColor3 = colorKey })
	else
		iconLabel = New("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			Text = iconValue,
			TextSize = 15,
			Font = Enum.Font.GothamBold,
			Parent = iconBg,
		})
		self:Style(iconLabel, { TextColor3 = colorKey })
	end

	local titleLabel = New("TextLabel", {
		Position = UDim2.fromOffset(56, 11),
		Size = UDim2.new(1, -70, 0, 16),
		Text = title,
		TextXAlignment = LEFT,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Font = Enum.Font.GothamBold,
		Parent = card,
	})
	self:Style(titleLabel, { TextColor3 = "Text" })

	if contentHeight > 0 then
		local descLabel = New("TextLabel", {
			Position = UDim2.fromOffset(56, 31),
			Size = UDim2.new(1, -70, 0, contentHeight),
			Text = content,
			TextWrapped = true,
			TextXAlignment = LEFT,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextSize = 12,
			Font = Enum.Font.Gotham,
			Parent = card,
		})
		self:Style(descLabel, { TextColor3 = "SubText" })
	end

	local progress = New("Frame", {
		Position = UDim2.new(0, 10, 1, -5),
		Size = UDim2.new(1, -20, 0, 2),
		BackgroundTransparency = 0.35,
		Parent = card,
	})
	Corner(1, progress)
	self:Style(progress, { BackgroundColor3 = colorKey })

	local handle = { Instance = wrapper }
	local dead = false
	local function dismiss()
		if dead or self.Destroyed then
			return
		end
		dead = true
		local index = table.find(self._notifs, handle)
		if index then
			table.remove(self._notifs, index)
		end
		self:Tween(card, 0.28, { Position = UDim2.new(1, 40, 0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In, function()
			self:Tween(wrapper, 0.2, { Size = UDim2.new(1, 0, 0, 0) }, nil, nil, function()
				wrapper:Destroy()
			end)
		end)
	end
	handle.Dismiss = dismiss

	local hit = New("TextButton", { Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = card })
	hit.Activated:Connect(dismiss)

	table.insert(self._notifs, handle)
	if #self._notifs > 6 then
		self._notifs[1].Dismiss()
	end

	self:Tween(card, 0.45, { Position = UDim2.new() }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	if duration > 0 then
		TweenService:Create(progress, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) }):Play()
		task.delay(duration, dismiss)
	else
		progress.Visible = false
	end
	self:LogActivity(title, kind)
	return handle
end

