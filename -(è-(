		BackgroundTransparency = 0.2,
		LayoutOrder = order or 0,
		Parent = parent,
	})
	Corner(10, card)
	self:Style(card, { BackgroundColor3 = "Surface" })
	self:Stroke(card, 0.35)
	Pad(12, 12, 12, 12, card)
	List(10, card)

	if title then
		local header = New("Frame", { Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, LayoutOrder = 1, Parent = card })
		local accent = New("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(3, 13),
			Parent = header,
		})
		Corner(2, accent)
		self:Style(accent, { BackgroundColor3 = "Accent" })
		local label = New("TextLabel", {
			Position = UDim2.fromOffset(11, 0),
			Size = UDim2.new(1, -11, 1, 0),
			Text = tostring(title),
			TextXAlignment = LEFT,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Font = Enum.Font.GothamBold,
			Parent = header,
		})
		self:Style(label, { TextColor3 = "Text" })
	end

	local body = New("Frame", {
		Name = "Body",
		Size = UDim2.new(1, 0, 0, 0),
