Components.Textbox = function(section, opts)
	local lib = section.Library
	local maid = Maid.new()
	local obj = { Type = "Textbox", Name = opts.Name }
	local r = CreateRow(section, opts, 160)
	local state = { focused = false, invalid = false }
	local value = tostring(opts.Default or "")

	local box = New("TextBox", {
		Name = "Input",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(150, 26),
		BackgroundTransparency = 0,
		Text = value,
		PlaceholderText = tostring(opts.Placeholder or "Type here..."),
		ClearTextOnFocus = false,
		TextXAlignment = LEFT,
		TextSize = 12,
		Font = Enum.Font.Gotham,
		Parent = r.Header,
	})
	Corner(6, box)
	Pad(0, 8, 0, 8, box)
	lib:Style(box, { BackgroundColor3 = "Surface", TextColor3 = "Text", PlaceholderColor3 = "Muted" })
	local stroke = lib:Stroke(box, 0.1)
	lib:_bind(stroke, function(theme)
		return { Color = state.invalid and theme.Error or (state.focused and theme.Accent or theme.Border) }
	end)

	local function validate(text)
		if opts.MaxLength and #text > opts.MaxLength then
			return false
		end
		if opts.Numeric and tonumber(text) == nil then
			return false
		end
		if opts.Validate then
			local ok, result = pcall(opts.Validate, text)
			if not ok or result == false then
				return false
			end
		end
		return true
	end

	function obj:GetValue()
		return value
	end
	function obj:SetValue(text, silent)
		text = tostring(text or "")
		value = text
		box.Text = text
		lib:_setFlag(opts.Flag, value)
		if not silent then
			safeCall(opts.Callback, value, false)
		end
	end
	function obj:_serialize()
		return value
	end
	function obj:_deserialize(v)
		obj:SetValue(v)
	end

	box.Focused:Connect(function()
		state.focused = true
		lib:Refresh(stroke, 0.15)
	end)
	box.FocusLost:Connect(function(enterPressed)
		state.focused = false
		local text = box.Text
		if text ~= "" and not validate(text) then
			state.invalid = true
			lib:Refresh(stroke, 0.1)
			box.Text = value
			task.delay(0.9, function()
				state.invalid = false
				if stroke.Parent then
					lib:Refresh(stroke, 0.25)
				end
			end)
			return
		end
		lib:Refresh(stroke, 0.15)
		value = text
		lib:_setFlag(opts.Flag, value)
		safeCall(opts.Callback, value, enterPressed)
	end)

	lib:_registerFlag(opts.Flag, obj)
	if value ~= "" then
		fireInit(opts, value, false)
	end
	return Finish(section, obj, r.Row, maid, function()
		if opts.Flag then
			lib._flagObjects[opts.Flag] = nil
		end
	end)
end

